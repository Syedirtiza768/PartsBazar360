DATABASE_URL=postgresql://postgres:postgres@localhost:5432/partsbazar360
REDIS_URL=redis://localhost:6379
OPENSEARCH_NODE=http://localhost:9200

# RealTrack read-only Published Listings Reader. Keep credentials in the secret manager.
REALTRACK_API_URL=https://mhn.realtrackapp.com/api
REALTRACK_API_EMAIL=
REALTRACK_API_PASSWORD=
# Optional JSON override when stores change; the reader account cannot call GET /stores.
# Default seed uses Salvage Auto Parts + Blackline Auto Parts only.
REALTRACK_STORE_MANIFEST_JSON=
# Set true only if you intentionally want all 11 reader-connected stores.
SEED_ALL_REALTRACK_STORES=false

SEED_EBAY_STORES=true
SEED_SPREADSHEET_SELLERS=true
SEED_AUTH_USERS=true
SEED_AUTH_PASSWORD=ChangeMe123!
SEED_ADMIN_EMAIL=admin@partsbazar360.com
SEED_BUYER_EMAIL=buyer@partsbazar360.com
SEED_DEACTIVATE_LEGACY_SELLERS=true
AUTH_JWT_SECRET=change-me-in-production

# MailerSend transactional email
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=info@partsbazar360.com
MAILERSEND_FROM_NAME=PartsBazar360

# Twilio Verify (checkout phone OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# SendGrid (checkout email OTP fallback while Twilio SMS is unavailable)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=info@partsbazar360.com
SENDGRID_FROM_NAME=PartsBazar360

# Stripe Checkout (hosted — card data never touches our servers). Use sandbox/test keys.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional; not required for hosted Checkout redirect flow.
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Tamara direct checkout. Keep API and notification tokens server-side.
# Sandbox: https://api-sandbox.tamara.co | Production: https://api.tamara.co
TAMARA_API_URL=https://api-sandbox.tamara.co
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
# Public key is only needed by Tamara's optional browser widgets.
TAMARA_PUBLIC_KEY=
# Buyer marketplace origin used for payment success/cancel URLs
BUYER_APP_URL=http://localhost:3000
# Internal URL for on-demand PDP cache purge (Docker: http://buyer-marketplace:3000/buyer)
BUYER_INTERNAL_URL=http://localhost:3000/buyer
# Shared secret for POST /buyer/api/revalidate/ (must match buyer REVALIDATE_SECRET)
REVALIDATE_SECRET=
# 0 = HTTP API only (enqueue jobs); 1 = also consume BullMQ (default for local/CLI)
RUN_INGESTION_WORKER=1
# Entrypoint schema mode: migrate | push | skip
SCHEMA_MODE=migrate
DATABASE_POOL_MAX=10
# Legacy generic payment confirm (optional; Stripe webhook is preferred)
PAYMENT_WEBHOOK_SECRET=

# Empty means every listing. Set a positive value only for local development.
SEED_EBAY_LISTING_LIMIT=
SEED_DXB_FILE=
SEED_FEBEST_FILE=
SEED_DYNATRADE_FILE=
SEED_FEBEST_CURRENCY=
SEED_FEBEST_WEIGHT_UNIT=
SEED_FEBEST_DIMENSION_UNIT=
SEED_DYNATRADE_CURRENCY=USD
SEED_DXB_CURRENCY=USD
SEED_FEBEST_CURRENCY=USD
SEED_WIPE_MARKETPLACE_INVENTORY=true
# Always false for RealTrack: persist remote image URLs only (prefer ebay hosts).
SEED_DOWNLOAD_IMAGES=false
SEED_UPDATE_EXISTING=true
SEED_REMOVE_STALE_OFFERS=false
SEED_IMPORT_COMPATIBILITY=true
SEED_IMPORT_ALL_IMAGES=true
SEED_REPORT_PATH=seed-report.json

# OpenRouter API key for AI-powered listing enrichment pipeline.
# Keep this secret — never expose in frontend code.
OPENROUTER_API_KEY=sk-or-...
# Default pipeline tier: budget | balanced | premium
LISTING_PIPELINE_DEFAULT=balanced

# ─── Listing price margin ───────────────────────────────────────────────────
# Listing price = filePrice / PRICE_MARGIN_DIVISOR. Default 0.7 means a 30%
# marketplace margin (listing price = file price / 0.7). Must be between 0
# and 1 (exclusive). Used during seller file uploads and reprice operations.
PRICE_MARGIN_DIVISOR=0.7

# ─── Shipping weight resolution ────────────────────────────────────────────────
# Billable weight is max(actual, volumetric). Volumetric = L*W*H(cm) / divisor.
# 6000 matches the active EMX/Aramex contract. IATA air freight uses 5000, which
# would raise every bulky quote by ~20% — only change if the contract changes.
SHIPPING_VOLUMETRIC_DIVISOR=6000
# When real dimensions are unknown, volumetric weight is derived from the part
# class's typical carton and dampened by this factor, so a misclassified part is
# not wildly over-quoted. Range 0-1.
SHIPPING_ESTIMATED_VOLUMETRIC_FACTOR=0.8
# Safety margin (percent) added to estimated weights only. Measured weights
# (spreadsheet / seller / verified) are never marked up.
SHIPPING_ESTIMATE_MARGIN_PCT=15
# Per-parcel courier ceiling in kg. The EMX sheet only defines bands up to 2kg,
# so anything heavier than this is priced at the ceiling and flagged with
# requiresFreightQuote=true instead of extrapolating the rate sheet.
SHIPPING_MAX_PARCEL_KG=30

# ─── AI enrichment (background weight/dimension estimation) ────────────────────
# Master switch. Ships OFF: parts fall back to deterministic part-class estimates
# until this is flipped, so the feature can be deployed before it is enabled.
ENRICHMENT_ENABLED=0
# Provider for weight/item-specifics: realtrack (default) | ai (legacy OpenRouter).
# Diagrams/SVG for ≥$300 parts still use OpenRouter when a key is present.
ENRICHMENT_PROVIDER=realtrack
# Hard daily spend ceiling in USD for *AI diagram* spend only (RealTrack has its
# own budget endpoint). Shared across replicas via Redis.
ENRICHMENT_DAILY_BUDGET_USD=5
# Worker concurrency. Low on purpose — these jobs are latency-tolerant because
# the PDP already painted, so this is a spend/rate-limit control.
ENRICHMENT_CONCURRENCY=2
# Model overrides; both default to entries in listing-pipeline/model-registry.ts.
# Primary is cheap; escalation is only used when the primary answer fails
# validation or comes back below the confidence threshold.
ENRICHMENT_WEIGHT_MODEL=google/gemini-2.5-flash
ENRICHMENT_ESCALATION_MODEL=openai/gpt-4.1-mini
# Flat marketplace item specifics (position, material, part type, …).
ENRICHMENT_ITEM_SPECIFICS_MODEL=google/gemini-2.5-flash
# Speculative search/hover warm-up. OFF by default — it flooded the queue and
# buried real PDP views. Set to 1 only if the worker has spare capacity.
ENRICHMENT_PREWARM=0
# When prewarm is on, refuse new speculative jobs if waiting+prioritized ≥ this.
ENRICHMENT_PREWARM_MAX_BACKLOG=4

# ─── Infographics (high-value parts only) ──────────────────────────────────────
# Parts whose top active offer reaches this price get a spec card generated and
# shown first in the PDP gallery. Re-checked on every run, so a part that later
# crosses the threshold picks one up automatically.
INFOGRAPHIC_MIN_PRICE_USD=300
# Only the card's *content* is generated and stored; the SVG itself is templated
# on demand, so a redesign is a deploy rather than a catalogue re-render.
INFOGRAPHIC_MODEL=openai/gpt-4.1-mini

# ─── Location / OEM callout diagram (PNG, high-value parts) ────────────────────
# Same price gate as the SVG card by default. Uses an OEM exploded diagram +
# callout when available; otherwise an illustrative location guide from the
# seller photo (never fabricates an OEM diagram).
LOCATION_DIAGRAM_MIN_PRICE_USD=300
LOCATION_DIAGRAM_MODEL=google/gemini-2.5-flash-image
# Shared volume path between api + worker for generated PNGs.
ENRICHMENT_MEDIA_DIR=/app/data/enrichment
