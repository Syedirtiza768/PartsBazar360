{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "buyer-marketplace",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=buyer-marketplace"],
      "port": 3000
    },
    {
      "name": "seller-portal",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "apps/seller-portal", "--port", "3100"],
      "port": 3100
    },
    {
      "name": "admin-portal",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "apps/admin-portal", "--port", "3200"],
      "port": 3200
    },
    {
      "name": "operations-portal",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "apps/operations-portal", "--port", "3300"],
      "port": 3300
    },
    {
      "name": "workshop-portal",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "apps/workshop-portal", "--port", "3400"],
      "port": 3400
    }
  ]
}
